<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="Chat lifecycle">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="user" value="User sends message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="gateway" value="Gateway validates JWT and routes request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="orchestrator" value="Chat orchestrator loads conversation, memory, and checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="guardrail" value="Guardrail allows request?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="65" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="refusal" value="Return refusal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="20" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="context" value="Add time and user context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="130" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="router" value="Router checks pending tasks and selects a route" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1280" y="115" width="230" height="105" as="geometry"/></mxCell>

        <mxCell id="faq" value="FAQ agent: HR policy RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="225" height="60" as="geometry"/></mxCell>
        <mxCell id="ticket" value="Ticket agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="355" y="340" width="225" height="60" as="geometry"/></mxCell>
        <mxCell id="booking" value="Booking agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="225" height="60" as="geometry"/></mxCell>
        <mxCell id="it" value="IT support agent: optional search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="925" y="340" width="225" height="60" as="geometry"/></mxCell>
        <mxCell id="resolved" value="Saved confirmation reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1210" y="340" width="225" height="60" as="geometry"/></mxCell>

        <mxCell id="toolcheck" value="Agent requests a tool?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="475" y="500" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="safe" value="Run read-only ticket or booking tool, or IT search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="175" y="665" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="pending" value="Save sensitive ticket or booking action and ask user to confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="665" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="decision" value="Next turn: confirm, edit, or cancel?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="825" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="execute" value="Execute saved call once, or cancel it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="840" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="supervisor" value="Supervisor combines results and chooses next agent or final answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="515" width="280" height="75" as="geometry"/></mxCell>
        <mxCell id="response" value="Return answer or clarification to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1340" y="520" width="220" height="65" as="geometry"/></mxCell>

        <mxCell id="e01" edge="1" parent="1" source="user" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e02" edge="1" parent="1" source="gateway" target="orchestrator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e03" edge="1" parent="1" source="orchestrator" target="guardrail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e04" value="no" edge="1" parent="1" source="guardrail" target="refusal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e05" value="yes" edge="1" parent="1" source="guardrail" target="context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e06" edge="1" parent="1" source="context" target="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e07" value="FAQ" edge="1" parent="1" source="router" target="faq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e08" value="ticket" edge="1" parent="1" source="router" target="ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e09" value="booking" edge="1" parent="1" source="router" target="booking" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="IT support" edge="1" parent="1" source="router" target="it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="pending reply" edge="1" parent="1" source="router" target="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="faq" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="ticket" target="toolcheck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" edge="1" parent="1" source="booking" target="toolcheck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="it" target="toolcheck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="no tool" edge="1" parent="1" source="toolcheck" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="safe tool" edge="1" parent="1" source="toolcheck" target="safe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="tool result; agent continues" edge="1" parent="1" source="safe" target="toolcheck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="sensitive tool" edge="1" parent="1" source="toolcheck" target="pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="ask user" edge="1" parent="1" source="pending" target="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="new user turn" edge="1" parent="1" source="pending" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="confirm or cancel" edge="1" parent="1" source="decision" target="execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="edit details" edge="1" parent="1" source="decision" target="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="continue request" edge="1" parent="1" source="execute" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" edge="1" parent="1" source="resolved" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="next capability" edge="1" parent="1" source="supervisor" target="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="done or clarification" edge="1" parent="1" source="supervisor" target="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" edge="1" parent="1" source="refusal" target="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
