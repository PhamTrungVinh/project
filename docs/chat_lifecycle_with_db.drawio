        <mxCell id="faq" value="FAQ agent: HR policy RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="845" width="225" height="60" as="geometry" /></mxCell>
