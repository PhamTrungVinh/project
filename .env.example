# Copy to .env and provide your own values. Never commit .env.
GROQ_API=
JWT_SECRET_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
HITL_ENABLED=true

# Use a strong URL-safe password (letters/numbers) for Compose database URLs.
POSTGRES_USER=support
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis is available at this localhost port; Compose uses redis:6379 internally.
REDIS_PORT=6379
# For Python services started directly on the host (optional):
REDIS_URL=redis://127.0.0.1:6379/0

# Compose configures owned databases, HTTP domain adapters, and local RAG.
# Optional published RAG artifact; leave empty to use the mounted local index.
RAG_ARTIFACT_URI=
RAG_ARTIFACT_VERSION=
